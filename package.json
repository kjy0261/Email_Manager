{
  "name": "mail-calendar-widget",
  "version": "1.0.0",
  "description": "Windows desktop widget that watches Daum mail over IMAP and turns work mails into calendar entries",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build:win": "electron-builder --win --publish never"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "imapflow": "^1.7.8",
    "mailparser": "^3.9.28"
  },
  "build": {
    "appId": "com.mailcalendarwidget.app",
    "productName": "MailCalendarWidget",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
